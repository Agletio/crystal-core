+// dst:drawQuad(src, x1,y1, x2,y2, x3,y3, x4,y4 [, "rotsprite"|"nearest"])
+// Draws src mapped onto the given parallelogram of dst, RotSprite by default.
+int Image_drawQuad(lua_State* L)
+{
+  auto obj = get_obj<ImageObj>(L, 1);
+  doc::Image* dst = obj->image(L);
+  auto srcObj = get_obj<ImageObj>(L, 2);
+  const doc::Image* src = srcObj->image(L);
+  int c[8];
+  for (int i = 0; i < 8; ++i)
+    c[i] = lua_tointeger(L, 3 + i);
+  const char* method = lua_isstring(L, 11) ? lua_tostring(L, 11) : "rotsprite";
+  if (std::strcmp(method, "nearest") == 0)
+    doc::algorithm::parallelogram(dst, src, nullptr, c[0], c[1], c[2], c[3], c[4], c[5], c[6], c[7]);
+  else
+    doc::algorithm::rotsprite_image(dst, src, nullptr, c[0], c[1], c[2], c[3], c[4], c[5], c[6], c[7]);
+  return 0;
+}
