{
  "name": "crystal-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "demo": "tsx src/demo.ts",
    "build": "esbuild src/web.ts --bundle --format=iife --minify --outfile=docs/app.js && npm run build:abyss && npm run build:gl",
    "watch": "esbuild src/web.ts --bundle --format=iife --outfile=docs/app.js --watch",
    "typecheck": "tsc --noEmit",
    "smoke": "node smoke.mjs",
    "shots": "node shots.mjs",
    "mods": "tsx src/mods-check.ts",
    "drag": "node dragprobe.mjs",
    "peek": "node tools/descent-peek.mjs",
    "comments": "node tools/comment-budget.mjs",
    "theme": "node tools/theme-check.mjs",
    "writing": "tsx tools/writing.mts",
    "writing:sync": "tsx tools/writing.mts sync",
    "writing:check": "tsx tools/writing.mts check",
    "writing:test": "tsx --test tools/writing.test.mts",
    "build:abyss": "esbuild world=src/abyss/assets/load-world.ts actors=src/abyss/assets/load-actors.ts props=src/abyss/assets/load-props.ts furniture=src/abyss/assets/load-furniture.ts --bundle --format=iife --minify --outdir=docs/abyss --log-level=warning",
    "abyss": "tsx tools/abyss/check.mts",
    "build:gl": "esbuild heroes=src/gl/assets/load-heroes.ts shallows=src/gl/assets/load-shallows.ts folk=src/gl/assets/load-folk.ts clips=src/gl/assets/load-clips.ts ground=src/gl/assets/load-ground.ts camp=src/gl/assets/load-camp.ts gear=src/gl/assets/load-gear.ts --bundle --format=iife --minify --outdir=docs/gl --log-level=warning"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.4",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@types/node": "^26.1.2",
    "@types/three": "^0.186.0",
    "esbuild": "^0.28.1",
    "jsdom": "^30.0.1",
    "meshoptimizer": "^1.2.0",
    "pixi.js": "^8.19.0",
    "playwright": "^1.56.1",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "three": "^0.186.0"
  }
}
