node_modules/

# Build output is COMMITTED on purpose — GitHub Pages serves static files and
# won't run a build. docs/app.js is deliberately NOT ignored here.

# Local Claude Code settings — machine-specific, not shared.
.claude/settings.local.json

*.log
npm-debug.log*
.DS_Store
Thumbs.db
.env
.env.local
*.tsbuildinfo
.vscode/
.idea/

# Screenshot output from `npm run shots` — regenerated, never reviewed.
shots/
# `descent-peek`'s own default name, regenerated every run. A picture worth
# keeping is committed under a name that says what it shows.
/descent*.png
# And from `npm run peek`, which writes here by default.
descent.png

# Generated PNGs. The converted GRID in src/render/generated-*.ts is what ships;
# the image it came from is disposable and a cloud VM is reclaimed anyway.
tools/art/cache/

# Session scratch: anything named *.tmp.* is a throwaway probe, and `.scratch/`
# is where a session's logs and one-off probes go.
*.tmp.*
.scratch/

# The creative director's pictures (`/critique`). The report, ART_REVIEW.md, is committed.
art-review/
